  <string name="otpilot_sensitive_todo">Czytaj powiadomienia z kodami</string>
  <string name="otpilot_sensitive_grant">Zezwól</string>
  <string name="otpilot_sensitive_desc_allowed">Android 15+ ukrywa przed większością aplikacji powiadomienia zawierające kody. OTPilot ma do nich dostęp.</string>
  <string name="otpilot_sensitive_desc_blocked">Android 15+ ukrywa przed większością aplikacji powiadomienia zawierające kody, a OTPilot jest teraz zablokowany. Z rootem: w KernelSU (i forkach jak KowSU czy SukiSU) najpierw zezwól OTPilot na liście Superuser w menedżerze, potem dotknij „Zezwól”; w Magisku dotknij „Zezwól” i zaakceptuj prośbę. Bez roota uruchom raz te polecenia ADB:</string>
  <string name="otpilot_sensitive_desc_unknown">OTPilot nie mógł odczytać z systemu stanu tego dostępu. Jeśli kody nie są kopiowane, dotknij „Zezwól” (z rootem; w KernelSU i jego forkach najpierw zezwól OTPilot w menedżerze) lub uruchom raz te polecenia ADB:</string>
  <string name="otpilot_sensitive_grant_failed">Root nie przyznał dostępu. Upewnij się, że OTPilot ma zezwolenie w menedżerze roota (w Magisku zaakceptuj prośbę), i dotknij ponownie „Zezwól”.</string>
  <string name="otpilot_sensitive_grant_no_su">OTPilot nie ma dostępu do roota. KernelSU i jego forki nigdy nie pokazują prośby: zezwól OTPilot na liście Superuser w menedżerze i dotknij ponownie „Zezwól”. Jeśli urządzenie nie ma roota, użyj poniższych poleceń ADB.</string>
  <string name="otpilot_sensitive_blocked_title">OTPilot nie widzi powiadomień z kodami</string>
  <string name="otpilot_sensitive_blocked_text">Android ukrywa przed OTPilot powiadomienia z kodami, więc nie zostaną skopiowane. Otwórz OTPilot, aby to naprawić.</string>
